# ---------- Build stage: compiles the PHP extensions (does not reach the final image) ----------
FROM php:8.4-fpm-bookworm AS build

ARG SQLSRV_VERSION=5.12.0

RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    unzip \
    unixodbc-dev \
    libicu-dev \
    libzip-dev \
    $PHPIZE_DEPS \
    && rm -rf /var/lib/apt/lists/*

RUN pecl install sqlsrv-${SQLSRV_VERSION} pdo_sqlsrv-${SQLSRV_VERSION} \
    && docker-php-ext-enable sqlsrv pdo_sqlsrv \
    && docker-php-ext-install bcmath intl opcache pcntl zip


# ---------- Vendor stage: Composer dependencies without the dev ones ----------
FROM build AS vendor

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer
WORKDIR /app

COPY composer.json composer.lock ./
RUN composer install --no-dev --no-scripts --no-autoloader --prefer-dist --no-interaction

# .dockerignore excludes vendor/, so this COPY does not overwrite the freshly installed vendor
COPY . .
RUN composer dump-autoload --optimize --no-dev --no-scripts


# ---------- Final stage: runtime libraries only, no compilers or Composer ----------
FROM php:8.4-fpm-bookworm AS final

RUN apt-get update && apt-get install -y --no-install-recommends \
    libicu72 \
    libzip4 \
    && curl -sSL -O https://packages.microsoft.com/config/debian/12/packages-microsoft-prod.deb \
    && dpkg -i packages-microsoft-prod.deb \
    && rm packages-microsoft-prod.deb \
    && apt-get update \
    && ACCEPT_EULA=Y apt-get install -y --no-install-recommends msodbcsql18 \
    && apt-get purge -y --auto-remove $PHPIZE_DEPS \
    && rm -rf /var/lib/apt/lists/*

# Already compiled extensions and their .ini files
COPY --from=build /usr/local/lib/php/extensions/ /usr/local/lib/php/extensions/
COPY --from=build /usr/local/etc/php/conf.d/ /usr/local/etc/php/conf.d/

# Production php.ini, and OPcache without timestamp checks (the image is immutable)
RUN cp /usr/local/etc/php/php.ini-production /usr/local/etc/php/php.ini \
    && { \
    echo 'expose_php=Off'; \
    echo 'memory_limit=256M'; \
    echo 'upload_max_filesize=20M'; \
    echo 'post_max_size=20M'; \
    echo 'opcache.enable=1'; \
    echo 'opcache.memory_consumption=128'; \
    echo 'opcache.max_accelerated_files=20000'; \
    echo 'opcache.validate_timestamps=0'; \
    } > /usr/local/etc/php/conf.d/zz-app.ini

# Production defaults; the deployment environment can override them.
# Logs go to stderr so Docker collects them (storage/ inside the container is ephemeral).
ENV APP_ENV=production \
    APP_DEBUG=false \
    LOG_CHANNEL=stderr

WORKDIR /var/www/html

COPY --from=vendor --chown=www-data:www-data /app/vendor ./vendor
COPY --chown=www-data:www-data . .

RUN mkdir -p storage/framework/cache storage/framework/sessions storage/framework/views storage/logs bootstrap/cache \
    && chown -R www-data:www-data storage bootstrap/cache \
    && chmod -R 775 storage bootstrap/cache

COPY --chmod=755 docker-entrypoint.prod.sh /usr/local/bin/docker-entrypoint.sh

# The entrypoint runs as root to read the Passport keys mounted with 600 permissions on the host.
# PHP-FPM workers still run as www-data (the pool's user).

EXPOSE 9000
ENTRYPOINT ["docker-entrypoint.sh"]
CMD ["php-fpm", "-F"]
