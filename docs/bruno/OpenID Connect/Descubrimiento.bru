meta {
  name: Descubrimiento
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/auth/.well-known/openid-configuration
  body: none
  auth: none
}

tests {
  test("responde 200 con el issuer y el jwks_uri", function () {
    expect(res.status).to.equal(200);
    expect(res.body.jwks_uri).to.equal(res.body.issuer + "/.well-known/jwks.json");
  });
}

docs {
  # Descubrimiento

  `GET /api/auth/.well-known/openid-configuration` · sin autenticación

  Documento de descubrimiento de OpenID Connect: endpoints (`authorization_endpoint`, `token_endpoint`, `userinfo_endpoint`, `jwks_uri`, `end_session_endpoint`) y valores soportados (`code`, `RS256`, `openid profile email`, `client_secret_basic` y `client_secret_post`, PKCE `S256`).
}
