meta {
  name: Llaves (JWKS)
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/auth/.well-known/jwks.json
  body: none
  auth: none
}

tests {
  test("responde 200 con una llave RSA", function () {
    expect(res.status).to.equal(200);
    expect(res.body.keys[0].kty).to.equal("RSA");
    expect(res.body.keys[0]).to.have.property("kid");
  });
}

docs {
  # Llaves (JWKS)

  `GET /api/auth/.well-known/jwks.json` · sin autenticación

  La misma llave de **Servicios / Clave pública**, como JWK (`kty`, `use`, `alg`, `kid`, `n`, `e`). El `kid` es la huella RFC 7638 de la llave y es el que lleva la cabecera de los `id_token`; cambia si se rotan las llaves.
}
