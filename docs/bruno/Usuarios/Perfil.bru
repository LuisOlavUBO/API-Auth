meta {
  name: Perfil
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/auth/v1/me
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("responde 200 con el usuario del token", function () {
    expect(res.status).to.equal(200);
    expect(res.body).to.have.property("id");
    expect(res.body).to.have.property("email");
  });
}

docs {
  # Perfil del usuario

  `GET /api/auth/v1/me` · Bearer de usuario con scope `user:read`

  Devuelve el usuario dueño del access token (`{{accessToken}}`, guardado por **Iniciar sesión** o **Registrar**).

  ## Respuesta 200

  ```json
  {
    "id": 1,
    "name": "Ana",
    "email": "ana@example.com",
    "email_verified_at": null,
    "created_at": "2026-10-27T12:00:00.000000Z"
  }
  ```

  ## Errores

  | Estado | `error` | Cuándo |
  |---|---|---|
  | 401 | `NO_AUTENTICADO` | Falta el token, o es inválido, vencido o revocado |
  | 403 | `SCOPE_INSUFICIENTE` | El token no tiene `user:read` |
}
