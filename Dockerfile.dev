# DEVELOPMENT image: the code is not copied, it comes from the bind mount in docker-compose.yml.
# Only PHP, the extensions and vendor/ (protected by a volume in the compose file) are baked in.
FROM php:8.4-fpm-bookworm

ARG USER_ID=1000
ARG GROUP_ID=1000
ARG SQLSRV_VERSION=5.12.0

# System and PECL build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    unzip \
    unixodbc-dev \
    libicu-dev \
    libzip-dev \
    $PHPIZE_DEPS \
    && rm -rf /var/lib/apt/lists/*

# Microsoft ODBC Driver 18 (needed by pdo_sqlsrv)
RUN curl -sSL -O https://packages.microsoft.com/config/debian/12/packages-microsoft-prod.deb \
    && dpkg -i packages-microsoft-prod.deb \
    && rm packages-microsoft-prod.deb \
    && apt-get update \
    && ACCEPT_EULA=Y apt-get install -y --no-install-recommends msodbcsql18 \
    && rm -rf /var/lib/apt/lists/*

# PHP extensions (pinned PECL versions for reproducible builds)
RUN pecl install sqlsrv-${SQLSRV_VERSION} pdo_sqlsrv-${SQLSRV_VERSION} \
    && docker-php-ext-enable sqlsrv pdo_sqlsrv \
    && docker-php-ext-install bcmath intl opcache pcntl zip \
    && rm -rf /tmp/pear

# Development php.ini (errors visible)
RUN cp /usr/local/etc/php/php.ini-development /usr/local/etc/php/php.ini

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

# www-data with the host user's UID/GID, so files are not left with another owner
RUN groupmod -o -g ${GROUP_ID} www-data \
    && usermod -o -u ${USER_ID} -g ${GROUP_ID} www-data

WORKDIR /var/www/html

# Dependencies only: the PSR-4 autoloader resolves app/ at runtime from the bind mount
COPY composer.json composer.lock ./
RUN composer install --no-scripts --no-interaction --prefer-dist \
    && chown -R www-data:www-data vendor

COPY --chmod=755 docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh

EXPOSE 9000
ENTRYPOINT ["docker-entrypoint.sh"]
CMD ["php-fpm", "-F"]
